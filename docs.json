{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Automagik",
  "colors": {
    "primary": "#FF3FF5",
    "light": "#FF3FF5",
    "dark": "#FF3FF5"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "decoration": "gradient"
  },
  "fonts": {
    "family": "Geist",
    "source": "/fonts/geist-latin.woff2",
    "format": "woff2"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "favicon": "/brand/genie-favicon.png",
  "navigation": {
    "products": [
      {
        "product": "Genie",
        "icon": "wand-magic-sparkles",
        "description": "Agent orchestration CLI",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "genie/index",
              "genie/installation",
              "genie/quickstart"
            ]
          },
          {
            "group": "Skills",
            "pages": [
              "genie/skills/index",
              "genie/skills/brainstorm",
              "genie/skills/wish",
              "genie/skills/work",
              "genie/skills/review",
              "genie/skills/council",
              "genie/skills/fix"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "genie/workflows",
              "genie/cli-reference",
              "genie/release-notes"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "genie/security/index",
              "genie/incident-response/canisterworm"
            ]
          },
          {
            "group": "Unlisted",
            "hidden": true,
            "pages": [
              "genie/hacks",
              "genie/security/key-rotation"
            ]
          }
        ]
      },
      {
        "product": "Omni",
        "icon": "comments",
        "description": "Unified messaging platform",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "omni/index",
              "omni/quickstart"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "omni/concepts/instances",
              "omni/concepts/agents",
              "omni/concepts/routes"
            ]
          },
          {
            "group": "CLI Reference",
            "pages": [
              "omni/cli/messaging",
              "omni/cli/agents",
              "omni/cli/management",
              "omni/cli/automations",
              "omni/cli/providers",
              "omni/cli/webhooks",
              "omni/cli/tts-batch-prompts",
              "omni/cli/events",
              "omni/cli/routes-persons-auth",
              "omni/cli/system",
              "omni/cli/debug"
            ]
          },
          {
            "group": "Architecture",
            "pages": [
              "omni/architecture/media",
              "omni/architecture/voice"
            ]
          }
        ]
      },
      {
        "product": "mikro",
        "icon": "brain",
        "description": "RLM algorithm CLI for coding agents",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "mikro/index",
              "mikro/quickstart"
            ]
          },
          {
            "group": "CLI Reference",
            "pages": [
              "mikro/cli/reference"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "mikro/config",
              "mikro/batch",
              "mikro/cache"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/brand/genie-logo.png",
    "dark": "/brand/genie-logo.png",
    "href": "/genie"
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://discord.gg/automagik"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/automagik-dev/genie"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/automagik_dev",
      "github": "https://github.com/automagik-dev",
      "discord": "https://discord.gg/automagik"
    }
  },
  "assistant": {
    "enabled": true,
    "display": "sidebar",
    "suggestions": [
      "How do I install Genie?",
      "How do I send a message with Omni?",
      "What does mikro do?"
    ]
  },
  "poweredBy": {
    "name": "Holocron",
    "url": "https://holocron.so"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/genie",
      "permanent": false
    }
  ]
}
